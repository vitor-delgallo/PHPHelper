{
  "description": "PHP Helper Classes",
  "name": "vitor-delgallo/phphelper",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "mervick/aes-bridge": "^2.0",
    "phpmailer/phpmailer": "^7.0",
    "phpoffice/phpspreadsheet": "^5.5",
    "aws/aws-sdk-php": "^3.376.2",
    "ext-curl": "*",
    "ext-simplexml": "*",
    "ext-openssl": "*",
    "ext-dom": "*",
    "ext-ctype": "*",
    "ext-zip": "*",
    "ext-libxml": "*",
    "phpunit/phpunit": "^11.0"
  },
  "suggest": {
    "phpmailer/phpmailer": "Requerido para envio de e-mails",
    "phpoffice/phpspreadsheet": "Requerido para planilhas Excel",
    "aws/aws-sdk-php": "Integração com o Amazon S3",
    "mervick/aes-bridge": "Criptografia multiplataforma (Security::encryptCrossPlatform)",
    "ext-curl": "Necessário para chamadas HTTP externas (HTTP::callWebService)",
    "ext-simplexml": "Necessário para manipulação de XML (Parser, Validator::validateXml)",
    "ext-openssl": "Necessário para a criptografia de Security",
    "ext-dom": "Necessário para manipular XML/DOM (Security::xssCleanRecursive, Parser, Mailer)",
    "ext-ctype": "Necessário para validações de tipo (Validator::isHex, S3Storage)",
    "ext-zip": "Necessário para manipulação de arquivos zip (File)",
    "ext-libxml": "Necessário para parsing de XML",
    "ext-intl": "Converte hosts internacionalizados para punycode (URL::getFormattedUrl)",
    "ext-fileinfo": "Detecção de content-type no upload (S3Storage)",
    "ext-iconv": "Code pages que o mbstring não tem (DBF: CP437, CP852, CP1250)"
  },
  "autoload": {
    "psr-4": {
      "VD\\PHPHelper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VD\\PHPHelper\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
